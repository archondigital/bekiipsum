// Cloudflare Workers config for bekiipsum.com.
// Static pages are served as Workers static assets (no Worker invocation); only /preview/*
// reaches the Worker. Built and deployed by Workers Builds on push to master, and by the
// Payload deploy hook on publish. See DEPLOY.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bekiipsum",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "vars": {
    "SITE_SLUG": "bekiipsum"
  },
  // CMS_URL is set on the Worker in the Cloudflare dashboard (Settings → Variables), not here.
  // keep_vars stops deploys from deleting it.
  "keep_vars": true,
  "observability": { "enabled": true },
  "workers_dev": true
}
